{
  "name": "AndroidMasterBoost",
  "displayName": "Android Master Boost",
  "expo": {
    "name": "Messenger Fake Conversation",
    "slug": "messenger-fake-conversation-siewka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/siewka_design_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/siewka_design_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7CB342"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siewkadesign.messengerfake"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/siewka_design_logo.png",
        "backgroundColor": "#7CB342"
      },
      "package": "com.siewkadesign.messengerfake",
      "versionCode": 1,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 23,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/siewka_design_logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje dost\u0119pu do zdj\u0119\u0107, aby dodawa\u0107 je do konwersacji.",
          "cameraPermission": "Aplikacja potrzebuje dost\u0119pu do aparatu, aby robi\u0107 zdj\u0119cia do konwersacji."
        }
      ]
    ]
  }
}
